APP_MODE=evaluation
APP_TIMEZONE=Africa/Lagos
PORT=3107
HOST=127.0.0.1
# Native local setup defaults to .local/socket, port 55439, database postgres.
# Set PG_BIN to your installed PostgreSQL 18 bin directory when different.
# PG_BIN=/usr/local/opt/postgresql@18/bin
# PGHOST=/absolute/path/to/project/.local/socket
# PGPORT=55439
# PGDATABASE=postgres
# Never place real passwords in this template. Compose requires three private values:
# PGOWNER_PASSWORD=
# PGPASSWORD=
# PGPROCESSOR_PASSWORD=
ALLOW_DEMO_SEED=false
DEMO_REFERENCE_DATE=2026-09-08
# EVIDENCE_DIR defaults to data/evidence-v2; SECRET_DIR defaults to .secrets.
# BACKUP_DIR, BACKUP_KEY and restore settings belong in private operator configuration.

# Opt in only for a disposable, synthetic hosted evaluation. Ignored outside evaluation mode.
ALLOW_PUBLIC_DEMO_LOGIN=false
