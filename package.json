{
  "name": "arewa-civic-tracker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.11.x"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "NODE_ENV=production node server.mjs",
    "build": "node scripts/build.mjs",
    "lint": "node scripts/check.mjs",
    "db:start": "node scripts/local-db.mjs",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "node scripts/migrate.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "import:demo": "node scripts/import-evaluation.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:db": "node --test tests/security.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "check": "npm run lint && npm run test:unit && npm run test:db && npm run test:integration && npm run test:e2e",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "sharp": "0.35.4"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6"
  },
  "packageManager": "npm@11.6.1"
}
